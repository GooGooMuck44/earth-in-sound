{
  "name": "earth-in-sound",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Hear Earth change: NASA GISTEMP, POWER, EONET and GIBS data as sound in the browser.",
  "scripts": {
    "data": "node scripts/fetch-data.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run && npm run test:data && npm run build && npm run test:offline",
    "test:unit": "vitest run",
    "test:offline": "node scripts/verify-offline.mjs",
    "test:data": "node --test scripts/validate-nasa.check.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "tone": "^15.1.22",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^5.1.0"
  }
}
